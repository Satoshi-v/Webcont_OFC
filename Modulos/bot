lim_rev() {
    _file_lim=$1
    [[ -z "$_file_lim" ]] && {
        ShellBot.sendMessage --chat_id ${message_chat_id[$id]} \
            --text "$(echo -e "Erro")"
        return 0
    }
    # Extraer usuario sin @ y sin espacios
    _rev_usern=$(grep -w 'Revendedor' $_file_lim | cut -d' ' -f2- | sed 's/@//g' | xargs)
    ajuste_cupos=$(grep -w 'Limite' $_file_lim | awk {'print $2'} | xargs)
    
    # Validaciones: permitir números con signo negativo
    [[ -z "$_rev_usern" ]] && {
        ShellBot.sendMessage --chat_id ${message_chat_id[$id]} \
            --text "$(echo -e "❌ Usuario no válido")" \
            --parse_mode html
        return 0
    }
    [[ ! "$ajuste_cupos" =~ ^\-?[0-9]+$ ]] && {
        ShellBot.sendMessage --chat_id ${message_chat_id[$id]} \
            --text "$(echo -e "❌ Debe ingresar un número (ej: 5 o -3)")" \
            --parse_mode html
        return 0
    }

    # Función para actualizar el límite en cualquier archivo (suma con signo)
    actualizar_limite() {
        local archivo=$1
        local usuario=$2
        local ajuste=$3
        # Usar awk para sumar (o restar si ajuste es negativo)
        awk -v u="$usuario" -v a="$ajuste" '
            $0 ~ u {
                for(i=1;i<=NF;i++){
                    if($i=="LIMITE:"){
                        $(i+1) += a
                        # Si el nuevo valor es menor que 0, lo fijamos a 0
                        if ($(i+1) < 0) $(i+1) = 0
                        break
                    }
                }
            }
            {print}
        ' "$archivo" > "${archivo}.tmp" && mv "${archivo}.tmp" "$archivo"
    }
    
    # Obtener límite actual antes de ajustar (para mostrar en mensaje)
    limite_actual=$(grep -w "$_rev_usern" $ativos | awk '{print $4}')
    
    # Calcular nuevo límite (solo para mostrar, el awk ya lo hará)
    nuevo_limite=$((limite_actual + ajuste_cupos))
    if [[ $nuevo_limite -lt 0 ]]; then
        nuevo_limite=0
        ShellBot.sendMessage --chat_id ${message_from_id[$id]} \
            --text "$(echo -e "⚠️ El límite no puede ser negativo. Se ha establecido a 0.")" \
            --parse_mode html
    fi
    
    # Determinar si es suma o resta para el mensaje
    if [[ $ajuste_cupos -ge 0 ]]; then
        operacion="➕ Sumados"
    else
        operacion="➖ Restados"
    fi
    
    # Caso 1: Revendedor activo
    if [[ -d /etc/bot/revenda/$_rev_usern ]]; then
        if [[ -f /etc/bot/revenda/$_rev_usern/$_rev_usern ]]; then
            l_old=$(grep -w 'LIMITE_REVENDA' /etc/bot/revenda/$_rev_usern/$_rev_usern | awk {'print $2'})
            l_new=$((l_old + ajuste_cupos))
            [[ $l_new -lt 0 ]] && l_new=0
            sed -i "/LIMITE_REVENDA/ s/$l_old/$l_new/g" /etc/bot/revenda/$_rev_usern/$_rev_usern
        fi
        actualizar_limite "$ativos" "$_rev_usern" "$ajuste_cupos"
        ShellBot.sendMessage --chat_id ${message_from_id[$id]} \
            --text "$(echo -e "=×=×=×=×=×=×=×=×=×=×=×\n<b>✅ CUPOS DE REVENTA AJUSTADOS !</b> !\n=×=×=×=×=×=×=×=×=×=×=×\n\n👤 Usuario: @$_rev_usern\n📊 Límite anterior: $limite_actual\n$operacion: ${ajuste_cupos#-}\n📊 Nuevo Límite: $nuevo_limite")" \
            --parse_mode html
    # Caso 2: Revendedor suspendido
    elif [[ -d /etc/bot/suspensos/$_rev_usern ]]; then
        if [[ -f /etc/bot/suspensos/$_rev_usern/$_rev_usern ]]; then
            l_old=$(grep -w 'LIMITE_REVENDA' /etc/bot/suspensos/$_rev_usern/$_rev_usern | awk {'print $2'})
            l_new=$((l_old + ajuste_cupos))
            [[ $l_new -lt 0 ]] && l_new=0
            sed -i "/LIMITE_REVENDA/ s/$l_old/$l_new/g" /etc/bot/suspensos/$_rev_usern/$_rev_usern
        fi
        actualizar_limite "$ativos" "$_rev_usern" "$ajuste_cupos"
        actualizar_limite "$suspensos" "$_rev_usern" "$ajuste_cupos"
        ShellBot.sendMessage --chat_id ${message_from_id[$id]} \
