    for id in $(ShellBot.ListUpdates); do
        (
            ShellBot.watchHandle --callback_data ${callback_query_data[$id]}
            [[ ${message_chat_type[$id]} != 'private' ]] && continue
            [[ ${message_text[$id]} ]] || restaure_backup
            CAD_ARQ=/tmp/cad.${message_from_id[$id]}
            if [[ ${message_entities_type[$id]} == bot_command ]]; then
                case ${message_text[$id]} in
                *)
                    comando=(${message_text[$id]})
                    [[ "${comando[0]}" = "/start" ]] && fun_menu
                    [[ "${comando[0]}" = "/menu" ]] && fun_menu
                    [[ "${comando[0]}" = "/info" ]] && infouserbot                    
                    [[ "${comando[0]}" = "/bot" || "${comando[0]}" = "/sobre" ]] && sobremim
                    ;;
                esac
            fi
            if [[ ${message_reply_to_message_message_id[$id]} ]]; then
                case ${message_reply_to_message_text[$id]} in
                '👤 CREAR USUARIO 👤\n\nNombre de usuario:')
                    verifica_acesso
                    [[ "$_erro" == '1' ]] && { fun_menu; exit 0; }
                    # --- VERIFICACIÓN DE LÍMITES PARA REVENDEDORES ---
                    if [[ "${message_from_id[$id]}" != "$id_admin" ]]; then
                        rev_usuario="${message_from_username}"
                        limite_total=$(grep -w "$rev_usuario" $ativos | awk '{print $4}')
                        fun_verif_limite_rev "$rev_usuario"
                        limite_disponible=$((limite_total - _result))
                        if [[ $limite_disponible -le 0 ]]; then
                            ShellBot.sendMessage --chat_id ${message_chat_id[$id]} \
                                --text "❌ No tienes cupos disponibles para crear usuarios." \
                                --parse_mode html
                            >$CAD_ARQ
                            fun_menu
                            exit 0
                        fi
                    fi
                    # --- FIN VERIFICACIÓN ---
                    [[ "$(awk -F : '$3 >= 1000 { print $1 }' /etc/passwd | grep -w ${message_text[$id]} | wc -l)" != '0' ]] && {
                        ShellBot.sendMessage --chat_id ${message_chat_id[$id]} \
                            --text "$(echo -e "❌ Error! USUARIO INVALIDO ❌\n\n⚠️ Ingrese Otro Nombre..")" \
                            --parse_mode html
                        >$CAD_ARQ
                        fun_menu
                        exit 0
                    }
                    [ "${message_text[$id]}" == 'root' ] && {
                        ShellBot.sendMessage --chat_id ${message_chat_id[$id]} \
                            --text "$(echo -e "❌ ERROR! USUARIO INVALIDO ❌\n\n⚠️ Ingrese Otro Nombre..")" \
                            --parse_mode html
                        >$CAD_ARQ
                        fun_menu
                        exit 0
                    }
                    sizemin=$(echo -e ${#message_text[$id]})
                    [[ "$sizemin" -lt '4' ]] && {
                        ShellBot.sendMessage --chat_id ${message_chat_id[$id]} \
                            --text "$(echo -e "❌ Error !\n\nUtilice al menos 4 caracteres\n[Ej: test]")" \
                            --parse_mode html
                        >$CAD_ARQ
                        fun_menu
                        exit 0
                    }
                    sizemax=$(echo -e ${#message_text[$id]})
                    [[ "$sizemax" -gt '10' ]] && {
                        ShellBot.sendMessage --chat_id ${message_chat_id[$id]} \
                            --text "$(echo -e "❌ Error !\n\nUse maximo 8 caracteres\n[Ej: Telegram]")" \
                            --parse_mode html
                        >$CAD_ARQ
                        fun_menu
                        exit 0
                    }
                    echo "Nome: ${message_text[$id]}" >$CAD_ARQ
                    ShellBot.sendMessage --chat_id ${message_from_id[$id]} \
                        --text 'Pass:' \
                        --reply_markup "$(ShellBot.ForceReply)"
                    ;;
                'Pass:')
