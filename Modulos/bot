    new_d=$(grep -w 'Data' $_datfile | awk '{print $NF}')
    if [[ -d "/etc/bot/suspensos/$_revd" ]]; then
        [[ "$(ls /etc/bot/suspensos/$_revd/usuarios | wc -l)" != '0' ]] && {
            for _user in $(ls /etc/bot/suspensos/$_revd/usuarios); do
                usermod -U $_user
            done
