alterar_data_user() {
    usuario=$1
    inputdate=$2
    database="/root/usuarios.db"

    if [[ $inputdate =~ ^[0-9]+$ ]]; then
        sysdate=$(date -d "+$inputdate days" +"%Y-%m-%d")
        udata=$(date -d "+$inputdate days" +"%d/%m/%Y")
    else
        sysdate=$(echo "$inputdate" | awk -F/ '{printf "%04d-%02d-%02d\n",$3,$2,$1}')
        udata="$inputdate"
    fi

    chage -E "$sysdate" "$usuario"
    usermod -e "$sysdate" "$usuario"

    if [[ -e /etc/bot/info-users/$usuario ]]; then
        old=$(awk -F : '{print $3}' /etc/bot/info-users/$usuario)
        sed -i "s;$old;$udata;" /etc/bot/info-users/$usuario
    fi

    if [[ -e /etc/bot/revenda/${message_from_username}/usuarios/$usuario ]]; then
        old=$(awk -F : '{print $3}' /etc/bot/revenda/${message_from_username}/usuarios/$usuario)
        sed -i "s;$old;$udata;" /etc/bot/revenda/${message_from_username}/usuarios/$usuario
    fi

    if grep -qw "$usuario" "$database"; then
        old=$(grep -w "$usuario" "$database" | awk '{print $2}')
        sed -i "/^$usuario / s/$old/$udata/" "$database"
    fi

    ShellBot.sendMessage --chat_id ${message_from_id[$id]} \
        --text "$(echo -e "=×=×=×=×=×=×=×=×=×=×=×\n<b>✅ DATO ALTERADO !</b>\n=×=×=×=×=×=×=×=×=×=×=×\n\n<b>Usuario:</b> $usuario\n<b>Nueva Fecha:</b> $udata")" \
        --parse_mode html
}
renovar_user() {
    usuario=$1
    # Obtener fecha de expiración actual del sistema
    expdate=$(chage -l "$usuario" | grep -i "Account expires" | awk -F: '{print $2}' | xargs)
    if [[ -z "$expdate" ]] || [[ "$expdate" == "never" ]]; then
        # Si no tiene fecha o es "never", usar fecha actual + 32 días
        new_date=$(date -d "+32 days" +"%Y-%m-%d")
        new_date_display=$(date -d "+32 days" +"%d/%m/%Y")
    else
        # Sumar 32 días a la fecha actual de expiración
        new_date=$(date -d "$expdate +32 days" +"%Y-%m-%d" 2>/dev/null)
        if [[ $? -ne 0 ]]; then
            # Si falla (formato raro), usar fecha actual + 32 días
            new_date=$(date -d "+32 days" +"%Y-%m-%d")
            new_date_display=$(date -d "+32 days" +"%d/%m/%Y")
        else
            new_date_display=$(date -d "$expdate +32 days" +"%d/%m/%Y")
        fi
    fi
    
    # Aplicar cambios al sistema
    chage -E "$new_date" "$usuario"
    usermod -e "$new_date" "$usuario"
    
    # Actualizar /etc/bot/info-users/$usuario
    if [[ -e /etc/bot/info-users/$usuario ]]; then
        old=$(awk -F : '{print $3}' /etc/bot/info-users/$usuario)
        sed -i "s;$old;$new_date_display;" /etc/bot/info-users/$usuario
    fi
    
    # Actualizar carpeta del revendedor
    if [[ -e /etc/bot/revenda/${message_from_username}/usuarios/$usuario ]]; then
        old=$(awk -F : '{print $3}' /etc/bot/revenda/${message_from_username}/usuarios/$usuario)
        sed -i "s;$old;$new_date_display;" /etc/bot/revenda/${message_from_username}/usuarios/$usuario
    fi
    
    # Actualizar /root/usuarios.db
    if grep -qw "$usuario" /root/usuarios.db; then
        old=$(grep -w "$usuario" /root/usuarios.db | awk '{print $2}')
        sed -i "/^$usuario / s/$old/$new_date_display/" /root/usuarios.db
    fi
    
    # Enviar mensaje de confirmación
    ShellBot.sendMessage --chat_id ${message_from_id[$id]} \
        --text "$(echo -e "=×=×=×=×=×=×=×=×=×=×=×\n<b>✅ USUARIO RENOVADO !</b>\n=×=×=×=×=×=×=×=×=×=×=×\n\n👤 Usuario: <b>$usuario</b>\n📅 Nueva Fecha: <b>$new_date_display</b>\n➕ Días agregados: <b>32</b>")" \
        --parse_mode html
}

